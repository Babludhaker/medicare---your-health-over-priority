// ============================================================
// MediCare Connect - Prisma Schema
// Multi-tenant healthcare appointment & patient record system
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum AppointmentStatus {
  HOLD // slot locked, awaiting payment
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PlanTier {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// ---------- TENANT ----------

model Clinic {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  address   String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  departments   Department[]
  doctors       DoctorProfile[]
  patients      PatientProfile[]
  appointments  Appointment[]
  subscription  ClinicSubscription?
  notifications Notification[]
  auditLogs     AuditLog[]
}

// ---------- IDENTITY ----------

model User {
  id              String    @id @default(uuid())
  clinicId        String?
  clinic          Clinic?   @relation(fields: [clinicId], references: [id])
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  twoFactorOn     Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  otpCode         String?
  otpExpiresAt    DateTime?
  verifyToken     String?
  resetToken      String?
  resetExpiresAt  DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([clinicId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- ORG STRUCTURE ----------

model Department {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  description String?       // ← yeh add karo
  doctors   DoctorProfile[]
  createdAt DateTime @default(now())

  @@unique([clinicId, name])
}

// ---------- DOCTOR ----------

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  specialization  String
  qualification   String?
  experienceYears Int      @default(0)
  consultationFee Decimal  @db.Decimal(10, 2)
  bio             String?
  isAcceptingNew  Boolean  @default(true)

  availabilities Availability[]
  blockedDates   BlockedDate[]
  appointments   Appointment[]

  @@index([clinicId, departmentId])
}

model Availability {
  id          String  @id @default(uuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startTime   String // "09:00"
  endTime     String // "13:00"
  slotMinutes Int     @default(30)
  isActive    Boolean @default(true)

  @@unique([doctorId, dayOfWeek, startTime])
}

model BlockedDate {
  id       String   @id @default(uuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  reason   String?

  @@index([doctorId, date])
}

// ---------- PATIENT ----------

model PatientProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  dateOfBirth  DateTime? @db.Date
  gender       String?
  bloodGroup   String?
  allergies    String?
  chronicNotes String?

  appointments   Appointment[]
  medicalRecords MedicalRecord[]

  @@index([clinicId])
}

// ---------- SCHEDULING (core) ----------

model Appointment {
  id            String            @id @default(uuid())
  clinicId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  doctorId      String
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       PatientProfile    @relation(fields: [patientId], references: [id])
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(HOLD)
  holdExpiresAt DateTime?
  reason        String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  medicalRecord MedicalRecord?
  prescription  Prescription?
  payment       Payment?

  // *** prevents double-booking at the DB level ***
  @@unique([doctorId, startTime])
  @@index([clinicId, status, startTime])
  @@index([patientId])
}

// ---------- EMR ----------

model MedicalRecord {
  id             String   @id @default(uuid())
  appointmentId  String   @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id])
  symptoms       String?
  diagnosis      String?
  bloodPressure  String?
  pulse          Int?
  temperature    Decimal? @db.Decimal(4, 1)
  spo2           Int?
  notes          String?
  documentUrls   String[]
  createdAt      DateTime @default(now())

  @@index([patientId])
}

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  advice        String?
  followUpDate  DateTime? @db.Date
  items         PrescriptionItem[]
  createdAt     DateTime @default(now())
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugName       String
  dosage         String // "500mg"
  frequency      String // "1-0-1"
  durationDays   Int
  instructions   String?
}

// ---------- BILLING ----------

model Payment {
  id              String        @id @default(uuid())
  appointmentId   String        @unique
  appointment     Appointment   @relation(fields: [appointmentId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPayId   String?
  razorpaySign    String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())

  invoice Invoice?

  @@index([status])
}

model Invoice {
  id        String   @id @default(uuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoiceNo String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())
}

// ---------- SaaS SUBSCRIPTION ----------

model SubscriptionPlan {
  id              String   @id @default(uuid())
  tier            PlanTier @unique
  name            String
  priceMonthly    Decimal  @db.Decimal(10, 2)
  maxDoctors      Int
  maxAppointments Int // per month, -1 = unlimited
  features        String[]

  subscriptions ClinicSubscription[]
}

model ClinicSubscription {
  id               String             @id @default(uuid())
  clinicId         String             @unique
  clinic           Clinic             @relation(fields: [clinicId], references: [id])
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  razorpaySubId    String?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id        String   @id @default(uuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String // APPOINTMENT | PAYMENT | SYSTEM
  isRead    Boolean  @default(false)
  readAt    DateTime? 
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------- AUDIT ----------

model AuditLog {
  id         String   @id @default(uuid())
  clinicId   String?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "APPOINTMENT_CANCELLED"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([clinicId, createdAt])
}
