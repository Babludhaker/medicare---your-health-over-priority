# ============================================
# MediCare Connect - Environment Configuration
# Copy this file to .env and fill in real values
# ============================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicare?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Auth security ---
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SLOT_HOLD_MINUTES=10

# --- SendGrid (email) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@medicareconnect.app
EMAIL_FROM_NAME=MediCare Connect

# --- Twilio (SMS / OTP) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+10000000000

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- AWS S3 (file storage) ---
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=medicare-connect-uploads

# --- Seed (super admin bootstrap) ---
SEED_SUPERADMIN_EMAIL=superadmin@medicareconnect.app
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
