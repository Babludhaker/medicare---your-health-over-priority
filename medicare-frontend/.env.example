# MediCare Connect — frontend environment variables
# Copy this file to `.env` and adjust as needed.

# API base URL.
# - In development, leave this unset: Vite proxies /api to the backend
#   (see vite.config.js) so the app calls the relative path /api/v1.
# - In production, set it to the deployed API origin, e.g.
#   VITE_API_URL=https://api.medicareconnect.app/api/v1
# VITE_API_URL=/api/v1

# Backend target for the dev proxy. Defaults to http://localhost:4000.
# VITE_PROXY_TARGET=http://localhost:4000
